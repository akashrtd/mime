{
  "name": "@mime-browser/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for MIME browser automation - Control browsers through MCP",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external @modelcontextprotocol/sdk && tsc --emitDeclarationOnly --outDir dist",
    "dev": "bun --watch src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "browser",
    "automation",
    "puppeteer",
    "playwright",
    "mcp",
    "model-context-protocol",
    "headless",
    "chrome",
    "web-scraping",
    "testing",
    "bun"
  ],
  "author": "Akash Rathod",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akashrtd/mime"
  },
  "homepage": "https://github.com/akashrtd/mime#readme",
  "bugs": {
    "url": "https://github.com/akashrtd/mime/issues"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}